# 开发环境配置
# Eruun API server (local dev, default port 8000)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MOCK_ENABLE=false
VITE_LOG_LEVEL=debug
VITE_ENABLE_ANALYTICS=false

# 登录守卫开关（后端认证接口就绪后设为 true）
VITE_AUTH_ENABLED=false

# 认证服务地址：/auth/login、/auth/login-code、/auth/logout 等端点
# 后端实现后按实际地址调整（默认同 Eruun API server）
VITE_PAAS_AUTH_BASE_URL=http://localhost:8000/api/v1
VITE_PAAS_API_BASE_URL=http://localhost:8000/api/v1
